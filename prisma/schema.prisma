generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  CASHIER
  PARENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}


enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StudentStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TopUpRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum WalletTransactionType {
  TOP_UP
  SALE_DEBIT
  PREORDER_DEBIT
  REFUND
  ADJUSTMENT
  OVERDRAFT_SALE
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum PreOrderStatus {
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
  NOT_COLLECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationEvent {
  ACCOUNT_APPROVED
  STUDENT_APPROVED
  TOPUP_REQUESTED
  TOPUP_CONFIRMED
  PURCHASE_COMPLETED
  PREORDER_CONFIRMED
  PREORDER_READY
  PREORDER_PICKED_UP
  PREORDER_CANCELLED
  REFUND_COMPLETED
  LOW_BALANCE
}

model School {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  address     String?
  phone       String?
  email       String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  settings    SchoolSettings?
  users       User[]
  students    Student[]
  pickupSlots PickupSlot[]
  sales       Sale[]
  preOrders   PreOrder[]
  registrationStudents StudentRegistrationRequest[]
  classStudentSequences ClassStudentSequence[]

  @@index([isActive])
  @@index([deletedAt])
}


model ClassStudentSequence {
  id           String   @id @default(cuid())
  schoolId     String
  classCode    String
  nextSequence Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, classCode])
  @@index([schoolId])
}

model SchoolSettings {
  id                         String   @id @default(cuid())
  schoolId                   String   @unique
  timezone                   String   @default("Australia/Brisbane")
  currency                   String   @default("AUD")
  preOrderEnabled            Boolean  @default(true)
  preOrderCutoffTime         String   @default("07:00")
  allowNegativeBalance       Boolean  @default(false)
  minimumAllowedBalance      Decimal  @default(0) @db.Decimal(12, 2)
  emailNotificationsEnabled  Boolean  @default(true)
  smsNotificationsEnabled    Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
}

model User {
  id               String     @id @default(cuid())
  fullName         String
  email            String     @unique
  phone             String?
  passwordHash     String
  role              UserRole
  status            UserStatus @default(PENDING)
  schoolId          String?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  school            School?         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  parentProfile     ParentProfile?
  cashierSales      Sale[]           @relation("CashierSales")
  overrideApprovals Sale[]           @relation("OverrideApprover")
  confirmedTopUps   TopUpRequest[]   @relation("TopUpConfirmer")
  requestedTopUps   TopUpRequest[]   @relation("TopUpRequester")
  auditLogs         AuditLog[]
  notifications     Notification[]
  approvedRegistrations ParentRegistrationRequest[] @relation("RegistrationApprover")

  @@index([role, status])
  @@index([schoolId])
  @@index([deletedAt])
}

model ParentRegistrationRequest {
  id               String                    @id @default(cuid())
  fullName         String
  email            String
  phone            String?
  passwordHash     String
  status           RegistrationRequestStatus @default(PENDING)
  approvedByUserId String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  approvedBy User?                        @relation("RegistrationApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  students   StudentRegistrationRequest[]

  @@index([status, createdAt])
  @@index([email, status])
}

model StudentRegistrationRequest {
  id                    String   @id @default(cuid())
  registrationRequestId String
  schoolId              String
  firstName             String
  lastName              String
  grade                  String
  classSection           String?
  officialSchoolId       String?
  photoUrl               String?
  createdAt              DateTime @default(now())

  registrationRequest ParentRegistrationRequest @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)
  school              School                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([registrationRequestId])
  @@index([schoolId])
}

model ParentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                    User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  students                Student[]
  wallet                  Wallet?
  notificationPreference  NotificationPreference?
}

model Student {
  id              String        @id @default(cuid())
  parentId        String
  schoolId        String
  classCode       String
  sequenceNumber  Int
  displayCode     String
  firstName       String
  lastName        String
  grade           String
  classSection    String?
  officialSchoolId String?
  photoUrl        String?
  qrToken         String        @unique
  status          StudentStatus @default(PENDING_APPROVAL)
  approvedAt      DateTime?
  approvedByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  parent            ParentProfile       @relation(fields: [parentId], references: [id], onDelete: Restrict)
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  walletTransactions WalletTransaction[]
  sales             Sale[]
  preOrders         PreOrder[]

  @@unique([schoolId, displayCode])
  @@unique([schoolId, classCode, sequenceNumber])
  @@index([parentId])
  @@index([schoolId, status])
  @@index([schoolId, classCode])
  @@index([firstName, lastName])
  @@index([deletedAt])
}

model Wallet {
  id          String       @id @default(cuid())
  parentId    String       @unique
  balance     Decimal      @default(0) @db.Decimal(12, 2)
  status      WalletStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent       ParentProfile       @relation(fields: [parentId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  topUpRequests TopUpRequest[]
  sales        Sale[]
  preOrders    PreOrder[]
}

model TopUpRequest {
  id              String             @id @default(cuid())
  walletId        String
  requestedById   String
  amount          Decimal            @db.Decimal(12, 2)
  status          TopUpRequestStatus @default(PENDING)
  confirmedById   String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  wallet          Wallet  @relation(fields: [walletId], references: [id], onDelete: Restrict)
  requestedBy     User    @relation("TopUpRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  confirmedBy     User?   @relation("TopUpConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  transaction     WalletTransaction?

  @@index([walletId, status])
  @@index([createdAt])
}

model WalletTransaction {
  id            String                @id @default(cuid())
  walletId      String
  studentId     String?
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @db.Decimal(12, 2)
  description   String?
  topUpRequestId String?              @unique
  saleId        String?               @unique
  preOrderId    String?               @unique
  createdAt     DateTime              @default(now())

  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  student       Student?      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  topUpRequest  TopUpRequest? @relation(fields: [topUpRequestId], references: [id], onDelete: Restrict)
  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  preOrder      PreOrder?     @relation(fields: [preOrderId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([studentId, createdAt])
  @@index([type, createdAt])
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  category    String?
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  saleItems     SaleItem[]
  preOrderItems PreOrderItem[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Sale {
  id                   String     @id @default(cuid())
  saleNumber           String     @unique
  idempotencyKey       String     @unique
  schoolId             String
  studentId            String
  walletId             String
  cashierUserId        String
  status               SaleStatus @default(COMPLETED)
  subtotal             Decimal    @db.Decimal(12, 2)
  total                 Decimal    @db.Decimal(12, 2)
  isOverdraftOverride  Boolean    @default(false)
  overrideApprovedById String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  school               School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  wallet               Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  cashier              User               @relation("CashierSales", fields: [cashierUserId], references: [id], onDelete: Restrict)
  overrideApprovedBy   User?              @relation("OverrideApprover", fields: [overrideApprovedById], references: [id], onDelete: Restrict)
  items                 SaleItem[]
  walletTransaction    WalletTransaction?

  @@index([schoolId, createdAt])
  @@index([studentId, createdAt])
  @@index([cashierUserId, createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model PickupSlot {
  id          String   @id @default(cuid())
  schoolId    String
  label       String
  startTime   String
  endTime     String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  preOrders   PreOrder[]

  @@index([schoolId, isActive, sortOrder])
}

model PreOrder {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  schoolId        String
  studentId       String
  walletId        String
  pickupSlotId    String
  pickupDate      DateTime
  status          PreOrderStatus @default(CONFIRMED)
  total           Decimal        @db.Decimal(12, 2)
  labelPrintedAt  DateTime?
  readyAt         DateTime?
  pickedUpAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  wallet          Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  pickupSlot      PickupSlot         @relation(fields: [pickupSlotId], references: [id], onDelete: Restrict)
  items           PreOrderItem[]
  walletTransaction WalletTransaction?

  @@index([schoolId, pickupDate, status])
  @@index([studentId, createdAt])
  @@index([pickupSlotId, pickupDate])
}

model PreOrderItem {
  id          String  @id @default(cuid())
  preOrderId  String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  preOrder    PreOrder @relation(fields: [preOrderId], references: [id], onDelete: Restrict)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([preOrderId])
  @@index([productId])
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  parentId              String   @unique
  emailEnabled          Boolean  @default(true)
  smsEnabled            Boolean  @default(false)
  pushEnabled           Boolean  @default(false)
  notifyTopUp           Boolean  @default(true)
  notifyPurchase        Boolean  @default(true)
  notifyPreOrder        Boolean  @default(true)
  notifyPickup          Boolean  @default(true)
  notifyRefund          Boolean  @default(true)
  notifyLowBalance      Boolean  @default(true)
  lowBalanceThreshold   Decimal? @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  parent                ParentProfile @relation(fields: [parentId], references: [id], onDelete: Restrict)
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  channel     NotificationChannel
  event       NotificationEvent
  subject     String?
  message     String
  metadata    Json?
  sentAt      DateTime?
  failedAt    DateTime?
  failureReason String?
  createdAt   DateTime            @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor       User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
