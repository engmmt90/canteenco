generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id                    String                       @id @default(cuid())
  code                  String                       @unique
  name                  String
  address               String?
  phone                 String?
  email                 String?
  logoUrl               String?
  isActive              Boolean                      @default(true)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  deletedAt             DateTime?
  classStudentSequences ClassStudentSequence[]
  pickupSlots           PickupSlot[]
  preOrders             PreOrder[]
  sales                 Sale[]
  settings              SchoolSettings?
  students              Student[]
  registrationStudents  StudentRegistrationRequest[]
  users                 User[]

  @@index([isActive])
  @@index([deletedAt])
}

model ClassStudentSequence {
  id           String   @id @default(cuid())
  schoolId     String
  classCode    String
  nextSequence Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School   @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, classCode])
  @@index([schoolId])
}

model SchoolSettings {
  id                        String   @id @default(cuid())
  schoolId                  String   @unique
  timezone                  String   @default("Australia/Brisbane")
  currency                  String   @default("AUD")
  preOrderEnabled           Boolean  @default(true)
  preOrderCutoffTime        String   @default("07:00")
  allowNegativeBalance      Boolean  @default(false)
  minimumAllowedBalance     Decimal  @default(0) @db.Decimal(12, 2)
  emailNotificationsEnabled Boolean  @default(true)
  smsNotificationsEnabled   Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  school                    School   @relation(fields: [schoolId], references: [id])
}

model User {
  id                    String                      @id @default(cuid())
  fullName              String
  email                 String                      @unique
  phone                 String?
  passwordHash          String
  role                  UserRole
  status                UserStatus                 @default(PENDING)
  schoolId              String?
  lastLoginAt           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  deletedAt             DateTime?
  auditLogs             AuditLog[]
  notifications         Notification[]
  parentProfile         ParentProfile?
  approvedRegistrations ParentRegistrationRequest[] @relation("RegistrationApprover")
  cashierSales          Sale[]                      @relation("CashierSales")
  overrideApprovals     Sale[]                      @relation("OverrideApprover")
  confirmedTopUps       TopUpRequest[]              @relation("TopUpConfirmer")
  requestedTopUps       TopUpRequest[]              @relation("TopUpRequester")
  school                School?                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([role, status])
  @@index([schoolId])
  @@index([deletedAt])
}

model ParentRegistrationRequest {
  id               String                    @id @default(cuid())
  fullName         String
  email            String
  phone            String?
  passwordHash     String
  status           RegistrationRequestStatus @default(PENDING)
  approvedByUserId String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  approvedBy       User?                     @relation("RegistrationApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  students         StudentRegistrationRequest[]

  @@index([status, createdAt])
  @@index([email, status])
}

model StudentRegistrationRequest {
  id                    String                    @id @default(cuid())
  registrationRequestId String
  schoolId              String
  firstName             String
  lastName              String
  grade                 String
  classSection          String?
  officialSchoolId      String?
  photoUrl              String?
  createdAt             DateTime                  @default(now())
  registrationRequest   ParentRegistrationRequest @relation(fields: [registrationRequestId], references: [id], onDelete: Cascade)
  school                School                    @relation(fields: [schoolId], references: [id])

  @@index([registrationRequestId])
  @@index([schoolId])
}

model ParentProfile {
  id                     String                  @id @default(cuid())
  userId                 String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  notificationPreference NotificationPreference?
  user                   User                    @relation(fields: [userId], references: [id])
  students               Student[]
  wallet                 Wallet?
}

model Student {
  id                 String              @id @default(cuid())
  parentId           String
  schoolId           String
  classCode          String
  sequenceNumber     Int
  displayCode        String
  firstName          String
  lastName           String
  grade              String
  classSection       String?
  officialSchoolId   String?
  photoUrl           String?

  // null = no daily spending limit
  dailySpendLimit    Decimal?            @db.Decimal(12, 2)

  qrToken            String              @unique
  status             StudentStatus       @default(PENDING_APPROVAL)
  approvedAt         DateTime?
  approvedByUserId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  preOrders          PreOrder[]
  sales              Sale[]
  parent             ParentProfile       @relation(fields: [parentId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  walletTransactions WalletTransaction[]

  @@unique([schoolId, displayCode])
  @@unique([schoolId, classCode, sequenceNumber])
  @@index([parentId])
  @@index([schoolId, status])
  @@index([schoolId, classCode])
  @@index([firstName, lastName])
  @@index([deletedAt])
}

model Wallet {
  id            String              @id @default(cuid())
  parentId      String              @unique
  balance       Decimal             @default(0) @db.Decimal(12, 2)
  status        WalletStatus        @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  preOrders     PreOrder[]
  sales         Sale[]
  topUpRequests TopUpRequest[]
  parent        ParentProfile       @relation(fields: [parentId], references: [id])
  transactions  WalletTransaction[]
}

model TopUpRequest {
  id            String             @id @default(cuid())
  walletId      String
  requestedById String
  amount        Decimal            @db.Decimal(12, 2)
  status        TopUpRequestStatus  @default(PENDING)
  confirmedById String?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  confirmedBy   User?              @relation("TopUpConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  requestedBy   User               @relation("TopUpRequester", fields: [requestedById], references: [id])
  wallet        Wallet             @relation(fields: [walletId], references: [id])
  transaction   WalletTransaction?

  @@index([walletId, status])
  @@index([createdAt])
}

model WalletTransaction {
  id             String                @id @default(cuid())
  walletId       String
  studentId      String?
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(12, 2)
  balanceAfter   Decimal               @db.Decimal(12, 2)
  description    String?
  topUpRequestId String?               @unique
  saleId         String?               @unique
  refundOfSaleId String?
  preOrderId     String?               @unique
  createdAt      DateTime              @default(now())
  preOrder       PreOrder?             @relation(fields: [preOrderId], references: [id], onDelete: Restrict)
  refundOfSale   Sale?                 @relation("SaleRefundTransactions", fields: [refundOfSaleId], references: [id], onDelete: Restrict)
  sale           Sale?                 @relation("SaleDebitTransaction", fields: [saleId], references: [id], onDelete: Restrict)
  student        Student?              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  topUpRequest   TopUpRequest?         @relation(fields: [topUpRequestId], references: [id], onDelete: Restrict)
  wallet         Wallet                @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([studentId, createdAt])
  @@index([refundOfSaleId])
  @@index([type, createdAt])
}

model Product {
  id            String         @id @default(cuid())
  sku           String         @unique
  name          String
  description   String?
  category      String?
  price         Decimal        @db.Decimal(12, 2)
  imageUrl      String?
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  preOrderItems PreOrderItem[]
  saleItems     SaleItem[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Sale {
  id                   String              @id @default(cuid())
  saleNumber           String              @unique
  idempotencyKey       String              @unique
  schoolId             String
  studentId            String
  walletId             String
  cashierUserId        String
  status               SaleStatus          @default(COMPLETED)
  subtotal             Decimal             @db.Decimal(12, 2)
  total                Decimal             @db.Decimal(12, 2)
  isOverdraftOverride  Boolean             @default(false)
  overrideApprovedById String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  cashier              User                @relation("CashierSales", fields: [cashierUserId], references: [id])
  overrideApprovedBy   User?               @relation("OverrideApprover", fields: [overrideApprovedById], references: [id], onDelete: Restrict)
  school               School              @relation(fields: [schoolId], references: [id])
  student              Student             @relation(fields: [studentId], references: [id])
  wallet               Wallet              @relation(fields: [walletId], references: [id])
  items                SaleItem[]
  refundTransactions   WalletTransaction[] @relation("SaleRefundTransactions")
  walletTransaction    WalletTransaction?  @relation("SaleDebitTransaction")

  @@index([schoolId, createdAt])
  @@index([studentId, createdAt])
  @@index([cashierUserId, createdAt])
}

model SaleItem {
  id                  String  @id @default(cuid())
  saleId              String
  productId           String
  productNameSnapshot String
  quantity            Int
  unitPrice            Decimal @db.Decimal(12, 2)
  lineTotal           Decimal @db.Decimal(12, 2)
  product             Product @relation(fields: [productId], references: [id])
  sale                Sale    @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model PickupSlot {
  id        String     @id @default(cuid())
  schoolId  String
  label     String
  startTime String
  endTime   String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  school    School     @relation(fields: [schoolId], references: [id])
  preOrders PreOrder[]

  @@index([schoolId, isActive, sortOrder])
}

model PreOrder {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  idempotencyKey    String             @unique
  schoolId          String
  studentId         String
  walletId          String
  pickupSlotId      String
  pickupDate        DateTime
  status            PreOrderStatus     @default(CONFIRMED)
  total             Decimal            @db.Decimal(12, 2)
  labelPrintedAt    DateTime?
  readyAt           DateTime?
  pickedUpAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  pickupSlot        PickupSlot          @relation(fields: [pickupSlotId], references: [id])
  school            School              @relation(fields: [schoolId], references: [id])
  student           Student             @relation(fields: [studentId], references: [id])
  wallet            Wallet              @relation(fields: [walletId], references: [id])
  items             PreOrderItem[]
  walletTransaction WalletTransaction?

  @@index([schoolId, pickupDate, status])
  @@index([studentId, createdAt])
  @@index([pickupSlotId, pickupDate])
}

model PreOrderItem {
  id         String   @id @default(cuid())
  preOrderId String
  productId  String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)
  preOrder   PreOrder @relation(fields: [preOrderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@index([preOrderId])
  @@index([productId])
}

model NotificationPreference {
  id                  String        @id @default(cuid())
  parentId            String        @unique
  emailEnabled        Boolean       @default(true)
  smsEnabled          Boolean       @default(false)
  pushEnabled         Boolean       @default(false)
  notifyTopUp         Boolean       @default(true)
  notifyPurchase      Boolean       @default(true)
  notifyPreOrder      Boolean       @default(true)
  notifyPickup        Boolean       @default(true)
  notifyRefund        Boolean       @default(true)
  notifyLowBalance    Boolean       @default(true)
  lowBalanceThreshold Decimal?      @db.Decimal(12, 2)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  parent              ParentProfile @relation(fields: [parentId], references: [id])
}

model Notification {
  id                String              @id @default(cuid())
  userId            String
  channel           NotificationChannel
  event             NotificationEvent
  subject           String?
  message           String
  metadata          Json?
  sentAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  attemptCount      Int                 @default(0)
  nextAttemptAt     DateTime?
  processingAt      DateTime?
  providerMessageId String?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([channel, sentAt, nextAttemptAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  CASHIER
  PARENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RegistrationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StudentStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TopUpRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum WalletTransactionType {
  TOP_UP
  SALE_DEBIT
  PREORDER_DEBIT
  REFUND
  ADJUSTMENT
  OVERDRAFT_SALE
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum PreOrderStatus {
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
  NOT_COLLECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationEvent {
  ACCOUNT_APPROVED
  STUDENT_APPROVED
  TOPUP_REQUESTED
  TOPUP_CONFIRMED
  PURCHASE_COMPLETED
  PREORDER_CONFIRMED
  PREORDER_READY
  PREORDER_PICKED_UP
  PREORDER_CANCELLED
  REFUND_COMPLETED
  LOW_BALANCE
}