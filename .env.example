# Neon pooled connection for runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/canteenco?sslmode=require"
# Neon direct connection for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/canteenco?sslmode=require"

APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional local/demo seed accounts. Never commit real passwords.
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_CASHIER_EMAIL="cashier@example.com"
SEED_CASHIER_PASSWORD="replace-with-a-strong-password"

# Notification delivery
NOTIFICATION_WORKER_SECRET="replace-with-a-long-random-secret"
RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM="CanteenCo <notifications@your-domain.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Development seed safety gate
ALLOW_DEMO_SEED="false"

# One-time production bootstrap; remove after first Super Admin is created
BOOTSTRAP_SUPER_ADMIN_NAME="CanteenCo Super Admin"
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
BOOTSTRAP_SUPER_ADMIN_PASSWORD=""
