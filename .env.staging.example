# Copy to .env.staging locally or configure as encrypted hosting/GitHub secrets.
# Never commit real passwords or API keys.

NODE_ENV="development"
STAGING_DATABASE_ACK="CANTEENCO_STAGING"

# Neon pooled runtime URL: hostname normally contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct CLI/migration URL: same endpoint without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-a-long-random-value-at-least-32-characters"
NOTIFICATION_WORKER_SECRET="generate-another-long-random-value-at-least-32-characters"

ALLOW_DEMO_SEED="false"

RESEND_API_KEY=""
NOTIFICATION_EMAIL_FROM=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
